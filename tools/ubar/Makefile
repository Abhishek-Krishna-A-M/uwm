PKG_CONFIG ?= pkg-config
CC ?= cc
WAYLAND_SCANNER ?= wayland-scanner

# Location of the wayland-protocols data files. Resolved through pkg-config so
# the same Makefile works on FHS distros (/usr/share/...) and on NixOS
# (/nix/store/...). Override on the command line if yours live elsewhere:
#   make WAYLAND_PROTOCOLS=/custom/share/wayland-protocols
WAYLAND_PROTOCOLS ?= $(shell $(PKG_CONFIG) --variable=pkgdatadir wayland-protocols)
XDG_SHELL_XML ?= $(WAYLAND_PROTOCOLS)/stable/xdg-shell/xdg-shell.xml

# -march=native is on by default for local builds. Store/distro builds must be
# portable across machines, so they pass NATIVE=0 (the flake does this).
NATIVE ?= 1
CFLAGS ?= -Wall -Wextra -pedantic -std=c11 -O3 -DNDEBUG
ifeq ($(NATIVE),1)
CFLAGS += -march=native
endif
CFLAGS += -Wno-unused-parameter
CFLAGS += -Iinclude -Isrc -Iprotocol
CFLAGS += $(shell $(PKG_CONFIG) --cflags wayland-client cairo pango pangocairo libpulse libpipewire-0.3 libudev)
LDLIBS = $(shell $(PKG_CONFIG) --libs wayland-client cairo pango pangocairo libpulse libpipewire-0.3 libudev) -lrt

SRC = $(wildcard src/*.c)
OBJ = $(patsubst src/%.c,build/%.o,$(SRC))

PROTO_SRC = protocol/uwm-bar-unstable-v1-client-protocol.c \
            protocol/wlr-layer-shell-unstable-v1-client-protocol.c \
            protocol/xdg-shell-client-protocol.c
PROTO_OBJ = $(patsubst protocol/%.c,build/protocol/%.o,$(PROTO_SRC))

PROTO_HDR = protocol/uwm-bar-unstable-v1-client-protocol.h \
            protocol/wlr-layer-shell-unstable-v1-client-protocol.h \
            protocol/xdg-shell-client-protocol.h

all: ubar

# All three protocols are generated by one stamp recipe instead of three
# two-target rules. A single target is safe under `make -j` (no concurrent
# wayland-scanner invocations clobbering each other's output) and works with
# old GNU make versions that lack grouped (`&:`) targets.
PROTO_STAMP = build/protocol-stamp
PROTO_XML = protocol/uwm-bar-unstable-v1.xml \
            protocol/wlr-layer-shell-unstable-v1.xml \
            $(XDG_SHELL_XML)

$(PROTO_STAMP): $(PROTO_XML)
	@mkdir -p protocol $(dir $@)
	$(WAYLAND_SCANNER) client-header < protocol/uwm-bar-unstable-v1.xml > protocol/uwm-bar-unstable-v1-client-protocol.h
	$(WAYLAND_SCANNER) private-code < protocol/uwm-bar-unstable-v1.xml > protocol/uwm-bar-unstable-v1-client-protocol.c
	$(WAYLAND_SCANNER) client-header < protocol/wlr-layer-shell-unstable-v1.xml > protocol/wlr-layer-shell-unstable-v1-client-protocol.h
	$(WAYLAND_SCANNER) private-code < protocol/wlr-layer-shell-unstable-v1.xml > protocol/wlr-layer-shell-unstable-v1-client-protocol.c
	$(WAYLAND_SCANNER) client-header < $(XDG_SHELL_XML) > protocol/xdg-shell-client-protocol.h
	$(WAYLAND_SCANNER) private-code < $(XDG_SHELL_XML) > protocol/xdg-shell-client-protocol.c
	@touch $@

# The generated sources materialize as a side effect of the stamp recipe.
# This rule teaches make that ordering, so `make -j` from a clean tree waits
# for the stamp instead of erroring on the not-yet-existing files.
$(PROTO_SRC) $(PROTO_HDR): $(PROTO_STAMP)
	@test -f $@

build/%.o: src/%.c $(PROTO_STAMP)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

build/protocol/%.o: protocol/%.c $(PROTO_STAMP)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

ubar: $(OBJ) $(PROTO_OBJ)
	$(CC) $(CFLAGS) -o $@ $(OBJ) $(PROTO_OBJ) $(LDLIBS)

clean:
	rm -rf build ubar
	rm -f $(PROTO_HDR) $(PROTO_SRC)

PREFIX ?= /usr
DESTDIR ?=
BINDIR = $(DESTDIR)$(PREFIX)/bin

install: ubar
	mkdir -p $(BINDIR)
	install -m 755 ubar $(BINDIR)/ubar

uninstall:
	rm -f $(BINDIR)/ubar

.PHONY: all clean install uninstall
